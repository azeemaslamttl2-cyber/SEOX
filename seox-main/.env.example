# Firebase Web App configuration.
# Copy this file to `.env` and fill in your values.
# All keys must be prefixed with VITE_ to be exposed to the client by Vite.

VITE_FIREBASE_API_KEY=AIzaSyBFBzzhp5rkUq3JEKVnBil4j_WheFdBuSI
VITE_FIREBASE_AUTH_DOMAIN=codestap-9a0b2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=codestap-9a0b2
VITE_FIREBASE_STORAGE_BUCKET=codestap-9a0b2.firebasestorage.app
VITE_FIREBASE_SENDER_ID=242145893439
VITE_FIREBASE_APP_ID=1:242145893439:web:4e1879e51999b8df3e6c8a
VITE_FIREBASE_MEASUREMENT_ID=G-G56E8XZWVX

# Optional: set only when the frontend is served separately from Pages Functions.
# Example: http://127.0.0.1:8788
VITE_ADMIN_API_BASE=

# DeepSeek AI API key (used by content tools for AI-powered analysis)
DEEPSEEK_API_KEY=

# SemanticsX local discovery and domain metrics (server-side only)
GOOGLE_PLACES_API_KEY=
OPEN_PAGERANK_API_KEY=
AHREFS_API_TOKEN=

# Google PageSpeed Insights API key
PAGESPEED_API_KEY=

# DataforSEO API credentials (used for keyword research tools and Brand Radar)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Search Console OAuth credentials.
# Add the callback URL to Google OAuth: https://your-domain.example/gsc/oauth-callback
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Pages server credentials. Prefer the single Firebase JSON secret.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or configure the same credentials as separate values:
FIREBASE_PROJECT_ID=codestap-9a0b2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated Firebase user emails allowed to open /admin.
# Example: owner@example.com,partner@example.com
ADMIN_EMAILS=

# Optional Firestore collection overrides.
ADMIN_PAYMENTS_COLLECTION=
ADMIN_NICHES_COLLECTION=
ADMIN_AFFILIATES_COLLECTION=

# Stripe Connect (server-side only)
STRIPE_SECRET_KEY=
APP_URL=https://your-domain.example
