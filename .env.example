# Local MySQL connection. Keep this file credential-free.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=code-step-mysql
AUTH_JWT_SECRET=replace-with-a-random-32-character-minimum-secret

# Optional: set only when the frontend is served separately from Pages Functions.
# Example: http://127.0.0.1:8788
VITE_ADMIN_API_BASE=

# DeepSeek AI API key (used by content tools for AI-powered analysis)
DEEPSEEK_API_KEY=

# Google PageSpeed Insights API key
PAGESPEED_API_KEY=

# DataforSEO API credentials (used for keyword research tools and Brand Radar)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google OAuth credentials (used for Google sign-in and Search Console).
# Add both callback URLs to the Google OAuth client:
#   http://localhost:3000/api/auth/google/callback
#   https://your-domain.example/api/auth/google/callback
#   https://your-domain.example/gsc/oauth-callback
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated local users allowed to open /admin.
ADMIN_EMAILS=

# Stripe Connect (server-side only)
STRIPE_SECRET_KEY=
APP_URL=https://your-domain.example
